# MongoDB is optional; the server falls back to its in-memory game store.
MONGODB_URI=mongodb://localhost:27017/codeopoly
PORT=5001

# Judge0 stays server-side. Use the RapidAPI endpoint below with a key, or point
# JUDGE0_API_URL at a self-hosted Judge0 instance (a key may then be omitted).
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
